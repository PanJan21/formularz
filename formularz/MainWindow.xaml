<Window x:Class="formularz.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:formularz"
        mc:Ignorable="d"
        Title="Rozszerzony Formularz" Height="520" Width="450" 
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Imię -->
        <TextBlock Grid.Row="0" Grid.Column="0" 
                   Text="Imię:" 
                   VerticalAlignment="Center" 
                   Margin="0,0,10,10" 
                   FontSize="14"/>
        <TextBox Grid.Row="0" Grid.Column="1" 
                 x:Name="ImieTextBox" 
                 Height="28" 
                 VerticalContentAlignment="Center" 
                 Margin="0,0,0,10" 
                 Padding="5,0"/>

        <!-- Nazwisko -->
        <TextBlock Grid.Row="1" Grid.Column="0" 
                   Text="Nazwisko:" 
                   VerticalAlignment="Center" 
                   Margin="0,0,10,10" 
                   FontSize="14"/>
        <TextBox Grid.Row="1" Grid.Column="1" 
                 x:Name="NazwiskoTextBox" 
                 Height="28" 
                 VerticalContentAlignment="Center" 
                 Margin="0,0,0,10" 
                 Padding="5,0"/>

        <!-- Płeć (RadioButtons) -->
        <TextBlock Grid.Row="2" Grid.Column="0" 
                   Text="Płeć:" 
                   VerticalAlignment="Center" 
                   Margin="0,0,10,10" 
                   FontSize="14"/>
        <StackPanel Grid.Row="2" Grid.Column="1" 
                    Orientation="Horizontal" 
                    VerticalAlignment="Center" 
                    Margin="0,0,0,10">
            <RadioButton x:Name="KobietaRadioButton" 
                         Content="Kobieta" 
                         GroupName="PlecGroup" 
                         Margin="0,0,20,0" 
                         FontSize="14"/>
            <RadioButton x:Name="MezyczyznaRadioButton" 
                         Content="Mężczyzna" 
                         GroupName="PlecGroup" 
                         FontSize="14"/>
        </StackPanel>

        <!-- Data urodzenia (DatePicker) -->
        <TextBlock Grid.Row="3" Grid.Column="0" 
                   Text="Data urodzenia:" 
                   VerticalAlignment="Center" 
                   Margin="0,0,10,10" 
                   FontSize="14"/>
        <DatePicker Grid.Row="3" Grid.Column="1" 
                    x:Name="DataUrodzeniaPicker" 
                    Height="28" 
                    VerticalContentAlignment="Center"
                    Margin="0,0,0,10"/>

        <!-- Dodatkowe informacje (Wielowierszowy TextBox) -->
        <TextBlock Grid.Row="4" Grid.Column="0" 
                   Text="Dodatkowe info:" 
                   VerticalAlignment="Top" 
                   Margin="0,0,10,10" 
                   FontSize="14"/>
        <TextBox Grid.Row="4" Grid.Column="1" 
                 x:Name="DodatkoweInfoTextBox" 
                 AcceptsReturn="True" 
                 TextWrapping="Wrap" 
                 VerticalContentAlignment="Top" 
                 Margin="0,0,0,10" 
                 Padding="5"/>

        <!-- Przyciski -->
        <StackPanel Grid.Row="5" Grid.Column="1" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,10,0,0">
            <Button x:Name="ZapiszButton" 
                    Content="Zapisz" 
                    Width="100" 
                    Height="30" 
                    Margin="0,0,10,0" 
                    Background="#007ACC" 
                    Foreground="White" 
                    FontWeight="Bold"
                    Click="ZapiszButton_Click"/>
            <Button x:Name="AnulujButton" 
                    Content="Anuluj" 
                    Width="100" 
                    Height="30"
                    Click="AnulujButton_Click"/>
        </StackPanel>
    </Grid>
</Window>